# Names only. Copy to .env.local and fill in; .env.local is never committed.
# Only VITE_ names reach the browser, so a secret must never start with VITE_.

# Server only: writes to Walrus Memory
MEMWAL_PRIVATE_KEY=
MEMWAL_ACCOUNT_ID=
MEMWAL_NAMESPACE=
MEMWAL_SERVER_URL=

# Server only: signs sessions and invites. Without it, sessions end when the server restarts.
MEMWAL_SESSION_SECRET=

# Server only: lets a trusted service such as Tatum AI Builder write, sent as x-api-key.
# Leave it empty to turn that route off.
MEMWAL_BRIDGE_API_KEY=

# Server only: Tatum Sui RPC, address checks and rates
TATUM_API_KEY=

# Server only: Walrus Console
CONSOLE_API_KEY=
CONSOLE_BUCKET_ID=
CONSOLE_SPACE_ID=
CONSOLE_SEAL_POLICY_ID=

# Server only: Enoki
ENOKI_API_KEY=

# Browser: safe to expose
VITE_MEMWAL_ACCOUNT_ID=
VITE_MEMWAL_NAMESPACE=
VITE_MEMWAL_SERVER_URL=
VITE_MEMWAL_CREATE_TX_DIGEST=
VITE_MEMWAL_ADD_KEYS_TX_DIGEST=

# Browser: the space signed out visitors look around. Falls back to VITE_MEMWAL_NAMESPACE.
VITE_DEMO_NAMESPACE=
