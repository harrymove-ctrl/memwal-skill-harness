{
  "name": "memwal-skill-harness",
  "private": true,
  "version": "0.1.0",
  "description": "Walrus Memory Namespace Skill Graph & DeepSeek-style Trajectory Eval Harness with Shared Delegate Keys",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite --port 5188",
    "build": "tsc -b && vite build && node scripts/check-bundle-secrets.mjs",
    "start": "node server.mjs",
    "preview": "vite preview --port 5188",
    "test": "vitest run",
    "seed:from-local": "node scripts/generate-seed.mjs",
    "video:studio": "npm --prefix video run studio",
    "video:render": "npm --prefix video run render",
    "check:secrets": "node scripts/check-bundle-secrets.mjs"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@mysten-incubation/dev-wallet": "^0.6.0",
    "@mysten-incubation/memwal": "^0.1.8",
    "@mysten/enoki": "^1.3.2",
    "@mysten/signers": "^1.1.36",
    "@mysten/sui": "^2.38.0",
    "@mysten/wallet-standard": "^0.21.36",
    "@noble/ed25519": "^2.3.0",
    "@noble/hashes": "^2.0.0",
    "@react-three/fiber": "^9.8.2",
    "@tailwindcss/vite": "^4.1.4",
    "clsx": "^2.1.1",
    "cn": "^0.5.0",
    "framer-motion": "^14.6.0",
    "glimm": "0.4.0",
    "lucide-react": "^0.511.0",
    "motion": "^14.7.1",
    "radix-ui": "^1.8.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.1.4",
    "three": "^0.186.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "typescript": "~5.8.3",
    "vite": "^6.3.2",
    "vitest": "^3.1.2"
  }
}
